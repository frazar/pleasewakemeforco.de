{
    "Reference": "https://github.com/DavidAnson/markdownlint/blob/main/schema/.markdownlint.jsonc",
    "default": true,
    "no-hard-tabs": true,
    "code-block-style": {
        "style": "fenced"
    },
    "MD012": false,
    "MD013": {
        "line_length": 80
    },
    "MD028": false,
    "MD030": false,
    "MD031": false,
    "MD032": false,
    "MD033": {
        "allowed_elements": [
            "details",
            "summary"
        ]
    },
    "MD034": false,
    "MD040": false,
    "MD041": false
}